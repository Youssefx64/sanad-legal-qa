# Sanad Environment Variables Configuration
# Copy this file to .env and fill in the required keys

# LLM & Embedding Providers
OPENROUTER_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Security & Admin API
ADMIN_API_KEY=sanad-admin-secret-key-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Experiment Tracking (MLflow)
MLFLOW_TRACKING_URI=http://localhost:5000

# Tracing & Observability (Langfuse)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# Frontend API base URL (used by frontend build/runtime)
VITE_API_BASE_URL=http://localhost:8000/api/v1
