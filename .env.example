# ==============================================================================
# Sanad (سند) — Environment Variables Template
# Copy this file to .env before starting services: `cp .env.example .env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOCK / OFFLINE MODE (No external API keys required)
# ------------------------------------------------------------------------------
# Set to 'true' to run 100% offline without any external LLM keys or network calls.
# In Mock Mode, Sanad uses local BM25 statutory retrieval, deterministic legal
# synthesis from the Egyptian Civil Code corpus, and heuristic evaluation scores.
# Note: If no LLM keys (OPENROUTER_API_KEY) are provided, Sanad auto-falls back to Mock Mode.
# Required: Optional (Default: false)
MOCK_MODE=

# ------------------------------------------------------------------------------
# 2. LLM & EMBEDDING PROVIDERS
# ------------------------------------------------------------------------------
# OpenRouter API Key (Primary cloud provider)
# Used for chat models (Nemotron, Gemma) and embedding models (Liquid, Nemotron Embed).
# Get a free API key at: https://openrouter.ai/keys (Free-tier models have ':free' suffix).
# Required: Optional (Required for live OpenRouter models; leave empty for Mock Mode / Ollama)
OPENROUTER_API_KEY=

# Custom OpenAI-compatible endpoint (Alternative cloud / self-hosted provider)
# Optional: Can be used with vLLM, LMStudio, Groq, DeepSeek, or any OpenAI-compatible API.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Local Ollama endpoint (Offline / local open-source models)
# Used for local models (e.g. qwen2.5:7b-instruct, llama3.1:8b).
# Run `ollama serve` locally. When running inside Docker on Linux, defaults to host gateway.
# Required: Optional (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (Qdrant)
# ------------------------------------------------------------------------------
# URL of the Qdrant vector store.
# When running via `docker compose`, Qdrant runs in container `sanad-qdrant` on port 6333.
# Required: Required for dense vector retrieval (Default: http://localhost:6333)
QDRANT_URL=http://localhost:6333

# Qdrant API key (Only needed if using Qdrant Cloud or protected Qdrant cluster).
# Leave empty for the local docker-compose Qdrant instance.
# Required: Optional (Default: empty)
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. SECURITY & API ACCESS
# ------------------------------------------------------------------------------
# Secret key protecting administrative endpoints (/admin/reindex, /admin/backup).
# ATTENTION: The default value below is for local DEVELOPMENT ONLY.
# In production, change this to a strong random token.
# Required: Optional for dev (Default: dev-admin-secret-key-change-in-production)
ADMIN_API_KEY=dev-admin-secret-key-change-in-production

# Allowed CORS origins for FastAPI (comma-separated list).
# Required: Optional (Default: http://localhost:5173,http://localhost:3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. EXPERIMENT TRACKING (MLflow)
# ------------------------------------------------------------------------------
# Tracking URI for logging evaluations, hyperparameter sweeps, and RAGAS metrics.
# When running via `docker compose`, MLflow runs in container `sanad-mlflow` on port 5000.
# If MLflow is unreachable, the system logs a warning and continues locally with zero crashes.
# Required: Optional (Default: http://localhost:5000)
MLFLOW_TRACKING_URI=http://localhost:5000

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED TRACING & OBSERVABILITY (Langfuse)
# ------------------------------------------------------------------------------
# Langfuse host and API credentials for query latency, LLM traces, and scoring.
# When running via `docker compose`, Langfuse runs in container `sanad-langfuse` on port 3001.
# Get free cloud keys at: https://cloud.langfuse.com (50k free traces/month).
# If keys are omitted, tracing degrades gracefully and stays disabled with zero errors.
# Required: Optional (Default: empty / disabled)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 7. RUNTIME & LOGGING
# ------------------------------------------------------------------------------
# Application log level: DEBUG, INFO, WARNING, ERROR
# Required: Optional (Default: INFO)
LOG_LEVEL=INFO

# Application environment: development, staging, production
# Required: Optional (Default: development)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 8. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for the backend API consumed by the React/Vite frontend.
# Required: Optional (Default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
