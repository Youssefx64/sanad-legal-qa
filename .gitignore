# ==============================================================================
# Sanad Legal Q&A — .gitignore
# ==============================================================================

# Python bytecode & packages
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
env/
venv/
ENV/
.bin/

# Testing, Coverage & Linters
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
backend/.coverage
coverage/
coverage.xml
htmlcov/
.mypy_cache/
backend/.mypy_cache/
.ruff_cache/
backend/.ruff_cache/

# Environment files & Secrets (Strictly ignored)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/

# Databases & Local volumes
*.db
*.sqlite
*.sqlite3
qdrant_storage/
postgres_data/
clickhouse_data/
grafana_data/

# MLflow & BentoML
mlruns/
mlartifacts/
bentos/
.bentoml/

# DVC local cache & temporary state
.dvc/cache/
.dvc/tmp/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.eslintcache
.vite/
frontend/.vite/

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS Files
.DS_Store
Thumbs.db
Desktop.ini
